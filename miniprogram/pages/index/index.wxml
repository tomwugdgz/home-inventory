<view class="page">
  <view style="display:flex;justify-content:space-between;align-items:flex-end;padding-top:8rpx">
    <view>
      <view class="h1">家物志</view>
      <view class="sub">东西放哪，一搜就知道</view>
    </view>
    <view style="width:76rpx;height:76rpx;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:600">T</view>
  </view>

  <view class="member-bar" bindtap="goMe">
    <view>
      <view class="t">{{member.level === 'vip' ? '✦ 家物志会员' : '免费版'}}</view>
      <view class="d">{{member.level === 'vip' ? '无限 AI 识别 · 已绑 ' + member.nfc_tags + ' 张贴' : '剩余 ' + member.tokens_left + ' 次 AI 识别 · 点此升级'}}</view>
    </view>
    <view style="background:var(--gold);color:#3A2800;font-size:24rpx;font-weight:600;padding:12rpx 24rpx;border-radius:30rpx">{{member.level === 'vip' ? '管理' : '升级'}}</view>
  </view>

  <view class="stat-row">
    <view class="stat"><view class="n" style="color:var(--accent)">{{items.length}}</view><view class="l">件物品</view></view>
    <view class="stat"><view class="n" style="color:var(--blue)">{{locations.length}}</view><view class="l">个位置</view></view>
    <view class="stat"><view class="n" style="color:#34C759">{{weekCount}}</view><view class="l">本周新增</view></view>
  </view>

  <view class="quick">
    <view class="qbtn" bindtap="goCapture">
      <view class="ic cam">📷</view>
      <view style="font-size:28rpx;font-weight:600">拍照识别 <text class="token-pill">✦ 会员</text></view>
      <view class="d">AI 认物品·记颜色用途</view>
    </view>
    <view class="qbtn" bindtap="goCaptureNfc">
      <view class="ic nfc">📶</view>
      <view style="font-size:28rpx;font-weight:600">NFC 感应</view>
      <view class="d">贴一下·可写入贴纸</view>
    </view>
  </view>

  <view class="sec-title"><text>最近记录</text><text style="color:var(--accent)" bindtap="goFind">查看全部 ›</text></view>

  <view wx:if="{{recent.length === 0}}" class="empty">还没有物品，点上面「拍照识别」记录第一件</view>
  <view wx:for="{{recent}}" wx:key="id" class="card" bindtap="showItem" data-id="{{item.id}}">
    <view style="width:96rpx;height:96rpx;border-radius:18rpx;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:48rpx;flex-shrink:0">
      <image wx:if="{{item.image_path}}" src="{{item.image_path}}" style="width:100%;height:100%;border-radius:18rpx" mode="aspectFill"/>
      <text wx:else>{{item.icon}}</text>
    </view>
    <view style="flex:1;min-width:0">
      <view style="font-size:28rpx;font-weight:600">{{item.colorDot}}{{item.name}}</view>
      <view class="sub" style="margin-top:6rpx">📍 {{item.locName}} · {{item.timeAgo}}</view>
    </view>
    <view style="font-size:22rpx;color:var(--muted);background:var(--bg);padding:8rpx 16rpx;border-radius:24rpx">{{item.category}}</view>
  </view>

  <view wx:if="{{error}}" class="tip warn">{{error}}</view>
</view>
