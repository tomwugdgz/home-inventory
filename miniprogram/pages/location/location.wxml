<view class="page">
  <view class="h1" style="padding-top:8rpx">收纳位置</view>
  <view class="sub">按房间 → 柜子 → 格子分级</view>
  <view class="sec-title"><text>我的空间（无限层级）</text><text style="color:var(--accent)" bindtap="addRoot">+ 新建房间</text></view>

  <view wx:if="{{roots.length === 0}}" class="empty">还没有位置，点右上「+ 新建房间」</view>

  <view wx:for="{{tree}}" wx:key="id" class="loc-card">
    <view class="loc-head" bindtap="toggle" data-id="{{item.id}}">
      <view class="loc-ic">🏠</view>
      <view style="flex:1">
        <view style="font-size:28rpx;font-weight:600">{{item.name}}</view>
        <view class="sub" style="font-size:22rpx">{{item.totalCount}} 件物品 · {{item.childCount}} 个子位置</view>
      </view>
      <text style="color:var(--muted);padding:8rpx 16rpx" catchtap="editLoc" data-id="{{item.id}}">⋯</text>
      <text style="color:var(--muted);transition:.2s;transform:{{item.open ? 'rotate(90deg)' : 'none'}}">›</text>
    </view>
    <view wx:if="{{item.open}}" class="loc-body">
      <view wx:for="{{item.children}}" wx:for-item="child" wx:key="id" class="subloc" style="padding-left:{{child.depth * 28}}rpx" bindtap="showItems" data-id="{{child.id}}">
        <text class="dot"></text>{{child.name}}
        <text class="sub" style="margin-left:auto;font-size:22rpx">{{child.count}} 件</text>
        <text style="color:var(--muted);padding:0 12rpx" catchtap="editLoc" data-id="{{child.id}}">⋯</text>
      </view>
      <view class="subloc" style="color:var(--accent)" bindtap="showItems" data-id="{{item.id}}">
        <text class="dot" style="background:var(--accent)"></text>查看此位置全部物品
      </view>
      <view class="subloc" style="color:var(--blue)" bindtap="addChild" data-id="{{item.id}}">
        <text class="dot" style="background:var(--blue)"></text>＋ 在此位置下新建子位置
      </view>
    </view>
  </view>

  <!-- 新建/编辑弹窗 -->
  <view wx:if="{{dialog}}" class="mask" bindtap="closeDialog">
    <view class="dlg-sheet" catchtap="noop">
      <view class="h2" style="margin-bottom:20rpx">{{dialog.title}}</view>
      <input wx:if="{{dialog.needName}}" placeholder="{{dialog.placeholder}}" value="{{dialog.name}}" bindinput="onName" class="dlg-input" focus="{{true}}"/>
      <view wx:if="{{dialog.needParent}}" class="field-wrap">
        <view class="sub" style="margin:16rpx 0 8rpx">上级位置</view>
        <picker mode="selector" range="{{parentNames}}" value="{{parentIndex}}" bindchange="onParent">
          <view class="picker-view">{{parentNames[parentIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{dialog.warn}}" class="tip warn" style="margin-top:16rpx">{{dialog.warn}}</view>
      <view class="btn-row">
        <button wx:if="{{dialog.isEdit}}" class="btn ghost" bindtap="deleteLoc">删除</button>
        <button class="btn primary" bindtap="confirmDialog">确定</button>
      </view>
    </view>
  </view>

  <!-- 位置物品列表 -->
  <view wx:if="{{locSheet}}" class="mask" bindtap="closeLocSheet">
    <view class="dlg-sheet" catchtap="noop">
      <view class="h2" style="margin-bottom:16rpx">{{locSheet.name}}</view>
      <view class="sub" style="margin-bottom:16rpx">共 {{locSheet.items.length}} 件</view>
      <view wx:for="{{locSheet.items}}" wx:key="id" class="loc-opt">{{item.name}} · {{item.category||'未分类'}}</view>
      <view wx:if="{{locSheet.items.length === 0}}" class="empty">这个位置还是空的</view>
    </view>
  </view>
</view>
