.loc-card { background:var(--surface); border:1rpx solid var(--line); border-radius:20rpx; margin-bottom:16rpx; overflow:hidden; }
.loc-head { display:flex; align-items:center; gap:20rpx; padding:26rpx; }
.loc-ic { width:64rpx; height:64rpx; border-radius:16rpx; background:#F0EAFF; color:var(--purple,#8E5CFF); display:flex; align-items:center; justify-content:center; font-size:32rpx; }
.loc-body { padding:0 26rpx 20rpx; }
.subloc { display:flex; align-items:center; gap:16rpx; padding:20rpx 0; border-top:1rpx solid var(--line); font-size:26rpx; }
.dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--line); flex-shrink:0; }
.mask { position:fixed; left:0;right:0;top:0;bottom:0; background:rgba(0,0,0,.4); z-index:100; display:flex; align-items:flex-end; }
.dlg-sheet { width:100%; background:var(--bg); border-radius:32rpx 32rpx 0 0; padding:36rpx 32rpx 60rpx; max-height:85vh; overflow-y:auto; }
.dlg-input { width:100%; border:1rpx solid var(--line); border-radius:16rpx; padding:22rpx; font-size:28rpx; background:var(--surface); box-sizing:border-box; }
.field-wrap { margin-top:8rpx; }
.picker-view { border:1rpx solid var(--line); border-radius:16rpx; padding:22rpx; font-size:28rpx; background:var(--surface); }
.loc-opt { padding:22rpx 0; border-bottom:1rpx solid var(--line); font-size:28rpx; }
