<view class="page">
  <view class="h1" style="padding-top:8rpx">更多</view>

  <view class="sec-title"><text>我的会员</text></view>
  <view class="member-bar">
    <view>
      <view class="t">{{member.level==='vip'?'✦ 家物志会员':'免费版'}}</view>
      <view class="d">{{member.level==='vip'?'无限 AI 识别':'剩余 '+member.tokens_left+' 次 AI 识别'}} · 已绑 {{member.nfc_tags}} 张贴</view>
    </view>
  </view>
  <view class="btn-row">
    <button wx:if="{{member.level!=='vip'}}" class="btn primary" bindtap="upgrade">升级会员 ¥12/月</button>
    <button wx:else class="btn ghost" bindtap="downgrade">切回免费版</button>
  </view>

  <view class="sec-title"><text>自定义设置</text></view>
  <view class="card" bindtap="manageTax" data-k="cat">
    <view style="width:80rpx;height:80rpx;border-radius:18rpx;background:#F0EAFF;display:flex;align-items:center;justify-content:center;font-size:40rpx">🏷️</view>
    <view style="flex:1"><view style="font-size:28rpx;font-weight:600">管理类别</view><view class="sub">{{cats.length}} 个 · 点标签可删</view></view>
    <text style="color:var(--muted)">›</text>
  </view>
  <view class="card" bindtap="manageTax" data-k="use">
    <view style="width:80rpx;height:80rpx;border-radius:18rpx;background:#E1F5EE;display:flex;align-items:center;justify-content:center;font-size:40rpx">🎯</view>
    <view style="flex:1"><view style="font-size:28rpx;font-weight:600">管理用途</view><view class="sub">{{uses.length}} 个</view></view>
    <text style="color:var(--muted)">›</text>
  </view>

  <view class="sec-title"><text>Token 用量</text></view>
  <view class="card" style="display:block">
    <view wx:for="{{ledger}}" wx:key="id" style="display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid var(--line);font-size:26rpx">
      <text>{{item.note}}</text><text style="color:var(--muted)">{{item.amount>0?'+':''}}{{item.amount}} · {{item.timeStr}}</text>
    </view>
    <view wx:if="{{ledger.length===0}}" class="sub" style="text-align:center;padding:24rpx">暂无记录</view>
  </view>

  <view class="sec-title"><text>NFC 贴商城 · 复购粘性</text></view>
  <view class="card">
    <view style="width:80rpx;height:80rpx;border-radius:18rpx;background:#E8F1FF;display:flex;align-items:center;justify-content:center;font-size:40rpx">📶</view>
    <view style="flex:1"><view style="font-size:28rpx;font-weight:600">家庭装 · 30 枚</view><view class="sub">预编码 UID · 跨 iPhone/安卓通用</view><view style="color:var(--accent);font-weight:600;margin-top:6rpx">¥49 · 满¥39包邮</view></view>
    <button class="buy" bindtap="buyTags">购买</button>
  </view>

  <view class="tip">数据存在你电脑的 SQLite 数据库，局域网多设备共享。AI 识别单次成本约 ¥0.0014，Token 是计量单位不是定价依据——你付费买的是「省打字、找得到」。当前为局域网 Demo，正式版走 SaaS 云订阅。</view>
  <view style="text-align:center;color:var(--muted);font-size:22rpx;margin-top:32rpx">家物志小程序 Demo v0.1 · 全栈智造专家团</view>

  <!-- 分类管理弹窗 -->
  <view wx:if="{{taxDialog}}" class="mask" bindtap="closeTax">
    <view class="sheet" catchtap="noop">
      <view class="h2" style="margin-bottom:16rpx">{{taxDialog.title}}</view>
      <view wx:for="{{taxList}}" wx:key="name" class="tax-opt" bindtap="removeTax" data-n="{{item.name}}">{{item.icon||'🏷️'}} {{item.name}} <text style="color:var(--accent);float:right">×</text></view>
      <input placeholder="新增名称" value="{{taxNew}}" bindinput="onTaxNew" class="tax-input"/>
      <button class="btn primary" bindtap="addTax" style="margin-top:16rpx">添加</button>
    </view>
  </view>
</view>
