.buy { background:var(--accent); color:#fff; font-size:24rpx; font-weight:600; padding:14rpx 28rpx; border-radius:28rpx; margin:0; }
.mask { position:fixed; left:0;right:0;top:0;bottom:0; background:rgba(0,0,0,.4); z-index:100; display:flex; align-items:flex-end; }
.sheet { width:100%; background:var(--bg); border-radius:32rpx 32rpx 0 0; padding:36rpx 32rpx 60rpx; max-height:80vh; overflow-y:auto; }
.tax-opt { padding:22rpx 0; border-bottom:1rpx solid var(--line); font-size:28rpx; }
.tax-input { width:100%; box-sizing:border-box; border:1rpx solid var(--line); border-radius:16rpx; padding:20rpx; font-size:28rpx; background:var(--surface); margin-top:24rpx; }
